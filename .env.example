# Copie para .env (que NÃO é versionado) e preencha. Nunca commite segredos reais.

DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/db_name
REDIS_URL=redis://localhost:6379/0

# JWT: em produção use >= 32 caracteres aleatórios (a aplicação recusa iniciar com
# chave fraca). Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACESSES_TOKEN_EXPIRE_MINUTES=60

ENV=development            # use "production" em produção
LINK_FRONTEND=http://localhost:5173/

API_KEY_MERCADO_PAGO=
MERCADO_PAGO_SECRET=       # segredo de assinatura do webhook
API_KEY_GROQ=
SENTRY_DSN=

# ---- Segurança (opcionais; os padrões são seguros) ----
# Origens permitidas (CORS + verificação de Origin), separadas por vírgula.
# CORS_ORIGINS=https://app.suaclinica.com.br
# /docs e /redoc ficam desligados em produção; ENABLE_DOCS=true reativa.
# ENABLE_DOCS=false
# Quantos proxies confiáveis existem na frente da API (Render=1; Cloudflare+Render=2).
# Confira em /api/v1 com um cabeçalho X-Forwarded-For de teste antes de ligar.
# TRUSTED_PROXY_HOPS=1
# WEBHOOK_TOLERANCE_SECONDS=300
# PENDING_APPOINTMENT_TTL_MINUTES=30
# MAX_PENDING_APPOINTMENTS_PER_USER=2
# CANCEL_MIN_HOURS_BEFORE=24
# LOGIN_MAX_FAILURES=10
# LOGIN_FAILURE_WINDOW_SECONDS=900
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MAX_COMPLETION_TOKENS=512
